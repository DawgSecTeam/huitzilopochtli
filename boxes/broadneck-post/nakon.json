            "PAYLOAD_PATH": "/opt/redtag/queue-tidy",
            "PAYLOAD_BODY": "truncate -s 0 /var/log/mail.log 2>/dev/null || true"
          }
        },
        {
          "name": "systemd-timer-persistence",
          "vars": {
