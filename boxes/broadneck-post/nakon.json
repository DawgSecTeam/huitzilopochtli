      "configurations": [
        {
          "name": "authorized-keys-persistence",
          "vars": {
            "USERNAME": "postmaster",
            "PUBLIC_KEY": "ssh-ed25519 c3NoLWVkMjU1MTkgUkVEVEFHREVQT1RLRVkwMTIzNDU2Nzg5YWJjZGVmZ2hpag== redtag@198.51.100.23"
          }
        },
        {
          "name": "cron-d-persistence",
          "vars": {
            "CRON_FILE": "queue-tidy",
