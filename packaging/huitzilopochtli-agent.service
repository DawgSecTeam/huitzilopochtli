# Huitzilopochtli agent systemd unit. See architecture.md §17.
# Install layout (packaging/README.md): honor ships .score.dat (0600),
# ranked ships identity.json (0600) — never both.
#
# Ranked: _run_ranked() loops forever -> long-running service, not oneshot.
# Honor: main() grades once and exits 0; Restart=on-failure does NOT
# restart a clean exit (unit settles at "inactive (exited)"), and the
# paired huitzilopochtli-agent.timer drives periodic re-grades — or swap
# the commented alternatives below. The SAME unit serves both modes:
# behavior comes from agent_config.json's "mode" field.
# Alternative Restart= policies (uncomment the one you want instead of
# the default below):
#   Restart=no          # recommended for a strictly one-shot honor install
#   Restart=on-failure  # default here: restarts only on nonzero exit/crash
#   Restart=always       # recommended for ranked mode if you want the
#                         # loop to auto-recover even after unexpected
#                         # clean exits (rare, since ranked's loop is
#                         # infinite by design)

[Unit]
Description=Huitzilopochtli scoring agent
Documentation=file:///opt/.huitzilopochtli/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/.huitzilopochtli/agent.pyz /opt/.huitzilopochtli/agent_config.json
# Mirrors report.html into each real user's $HOME/Documents/huitzilopochtli
# (a snap-confined browser can't read /opt, so shortcuts point at $HOME).
# NOTE: with Type=simple this fires when the process is FORKED, racing the
# grade — the agent itself now syncs at the END of every honor grade
# (agent/__main__.py::_sync_desktop_copies); this remains for ranked mode's
# first snapshot only (its loop never re-fires ExecStartPost) + fallback.
ExecStartPost=/opt/.huitzilopochtli/sync-report.sh
WorkingDirectory=/opt/.huitzilopochtli
Restart=on-failure
RestartSec=5s

# Hardening (best-effort; loosen if the agent's checks need broader
# access to inspect the host -- many checks legitimately need root).
# ProtectHome is off (not read-only) because ExecStartPost above needs to
# write into each real user's $HOME.
ProtectHome=false
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
