#!/sbin/openrc-run
# Huitzilopochtli agent OpenRC init script (Alpine/musl), functional
# equivalent of packaging/huitzilopochtli-agent.service (architecture.md
# §17; install layout: packaging/README.md).
# Alpine caveat: minimal images ship without python3 — `apk add python3`
# at provisioning or this service cannot start.
# The honor agent runs once and exits, so rc-status showing it "stopped"
# shortly after start is expected (both modes are backgrounded here).
# No OpenRC re-grade timer exists: for honor-mode periodic re-grades add
# a cron entry (`* * * * * rc-service huitzilopochtli-agent restart`).

name="huitzilopochtli-agent"
description="Huitzilopochtli scoring agent"

command=/usr/bin/python3
command_args="/opt/.huitzilopochtli/agent.pyz /opt/.huitzilopochtli/agent_config.json"
command_background=true
directory=/opt/.huitzilopochtli

pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
	# Ranked check-ins need the engine; honor works offline. Same script
	# serves both modes (agent_config.json selects).
	need net
	use dns
	after firewall
}
