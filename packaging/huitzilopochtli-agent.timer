# Periodic re-grade for honor-mode boxes only: the honor agent runs once and
# exits, and the service's Restart=on-failure does not restart a clean exit
# (see huitzilopochtli-agent.service), so without this timer report.html
# would stay an install-time snapshot — report.html's meta-refresh
# (architecture.md §13) expects exactly these periodic rewrites. Ranked's
# agent already loops forever; install_init() enables this only for honor.
# OnUnitActiveSec is deliberately short: re-grading is cheap local checks,
# and a fix should show up on the report within about a minute.

[Unit]
Description=Periodic re-grade for the Huitzilopochtli scoring agent (honor mode)
Documentation=file:///opt/.huitzilopochtli/README.md

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
Unit=huitzilopochtli-agent.service

[Install]
WantedBy=timers.target
