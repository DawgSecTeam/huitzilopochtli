HUITZILOPOCHTLI_BIND=0.0.0.0
HUITZILOPOCHTLI_PORT=8080
HUITZILOPOCHTLI_DB_PATH=/var/lib/huitzilopochtli/engine.db
HUITZILOPOCHTLI_ADMIN_USER=admin
HUITZILOPOCHTLI_ADMIN_PASSWORD=change-me
HUITZILOPOCHTLI_SERVER_SECRET=change-me-too
HUITZILOPOCHTLI_CHECKIN_INTERVAL_S=60
HUITZILOPOCHTLI_RATE_LIMIT_PER_MIN=600
HUITZILOPOCHTLI_RATE_BURST=100
HUITZILOPOCHTLI_MAX_CONNS=128
HUITZILOPOCHTLI_MAX_VERIFY=4
HUITZILOPOCHTLI_WORKSHOP_URL=
# Portal admin password (Basic auth): the engine provisions one private pool
# per competition from the scenario's pool: block (RANKED_COMPETITION.md 3.1)
HUITZILOPOCHTLI_WORKSHOP_ADMIN_PASSWORD=
# Shared with the portal's HUITZ_PREBIND_SECRET: the engine hands the portal
# the player's one-time join code so the VM joins itself on first open
HUITZILOPOCHTLI_WORKSHOP_SECRET=
# Seconds between background sweeps that retry VM claims and provisioning
HUITZILOPOCHTLI_SWEEP_INTERVAL_S=15
HUITZILOPOCHTLI_PUBLIC_URL=http://127.0.0.1:8080
